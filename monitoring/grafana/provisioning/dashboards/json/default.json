{
  "title": "Email Scheduler",
  "uid": "email-scheduler",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Worker Up",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "worker_up",
          "legendFormat": "Worker",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Jobs",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "active_jobs",
          "legendFormat": "Active Jobs",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Messages Processed (total)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }
      },
      "targets": [
        {
          "expr": "messages_processed_total",
          "legendFormat": "Processed",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Messages Sent (total)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }
      },
      "targets": [
        {
          "expr": "messages_sent_total",
          "legendFormat": "Sent",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "title": "DLQ Messages (total)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "dlq_messages_total",
          "legendFormat": "DLQ",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Redis Lock Failures (total)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "redis_lock_failures_total",
          "legendFormat": "Lock Failures",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 7,
      "title": "Message Throughput (per second)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(messages_processed_total[1m])",
          "legendFormat": "Processed/s",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "rate(messages_sent_total[1m])",
          "legendFormat": "Sent/s",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "rate(messages_failed_total[1m])",
          "legendFormat": "Failed/s",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "rate(messages_retried_total[1m])",
          "legendFormat": "Retried/s",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 8,
      "title": "Job Processing Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(message_processing_duration_seconds_bucket[1m]))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, rate(message_processing_duration_seconds_bucket[1m]))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.99, rate(message_processing_duration_seconds_bucket[1m]))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 9,
      "title": "HTTP Request Rate (per second)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (route, method)",
          "legendFormat": "{{method}} {{route}}",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 10,
      "title": "HTTP Request Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, route))",
          "legendFormat": "p50 {{route}}",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, route))",
          "legendFormat": "p95 {{route}}",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, route))",
          "legendFormat": "p99 {{route}}",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 11,
      "title": "HTTP Errors by Status Code",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"4..|5..\"}[1m])) by (status_code, route)",
          "legendFormat": "{{status_code}} {{route}}",
          "datasource": { "type": "prometheus" }
        }
      ]
    },
    {
      "id": 12,
      "title": "DLQ & Retry Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rate(dlq_messages_total[1m])",
          "legendFormat": "DLQ/s",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "rate(messages_retried_total[1m])",
          "legendFormat": "Retried/s",
          "datasource": { "type": "prometheus" }
        },
        {
          "expr": "rate(redis_lock_failures_total[1m])",
          "legendFormat": "Lock Failures/s",
          "datasource": { "type": "prometheus" }
        }
      ]
    }
  ]
}
